# ========== Modelo de lenguaje (API compatible con OpenAI) ==========
# Sin LLM_API_KEY la app corre en MODO DEMO: el flujo completo funciona,
# con devoluciones de ejemplo (sirve para mostrar la herramienta sin costo).

# --- OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Gemini (capa gratuita) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Anthropic (Claude) ---
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-4-5

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- Ollama local / servidor propio (sin datos hacia terceros) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ========== Correo saliente (opcional) ==========
# Si se configura, al aprobarse la devolución final se le envía al estudiante.
# SMTP_HOST=smtp.tu-institucion.edu
# SMTP_PORT=587
# SMTP_USER=lidia@tu-institucion.edu
# SMTP_PASS=
# SMTP_FROM=lidia@tu-institucion.edu
# SMTP_TLS=1

# ========== Despliegue ==========
# Prefijo bajo el que se sirve la app detrás del proxy inverso.
# Vacío = raíz (desarrollo local). Ej. en producción: tu-dominio.edu/entregas
# BASE_PATH=/entregas

# ========== Datos ==========
# DATA_DIR=./data

# URL pública de LidIA. Si está, los correos incluyen un enlace directo a la aplicación;
# si falta, el correo se manda igual pero sin enlace.
APP_URL=https://tu-dominio/entregas
# En producción: APP_URL=https://licdia.unlu.edu.ar/entregas

# Modo de prueba: desvía TODO el correo a esta dirección en lugar de al destinatario real.
# Dejar vacío o comentado en producción.
# SMTP_DESVIAR_A=vos@ejemplo.com
